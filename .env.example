# Prowlarr
PROWLARR_URL=http://prowlarr-host:9696
PROWLARR_API_KEY=

# TorrentLeech (user/pass auth)
TL_USERNAME=
TL_PASSWORD=
TL_2FA_TOKEN=

# TorrentBD (cookie auth)
# Browser -> DevTools -> Application -> Cookies -> copy full "name=value; name=value" string
TBD_COOKIE=
# Must be the EXACT User-Agent of the browser that produced TBD_COOKIE
TBD_USERAGENT=

# qBittorrent WebUI (host machine)
QBT_URL=http://192.168.1.<host>:8080
QBT_USERNAME=admin
QBT_PASSWORD=
